APP_ENV=development
DEMO_MODE=true
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://tihbc:secret@localhost:5433/tihbc
TEST_DATABASE_URL=postgresql+asyncpg://tihbc:secret@localhost:5433/tihbc_test
REDIS_URL=redis://localhost:6380/0
TEST_REDIS_URL=redis://localhost:6380/15
RUN_MIGRATIONS=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=720
LOG_LEVEL=INFO
TIMEZONE_DISPLAY=Asia/Karachi
UPLOAD_MAX_MB=10
UPLOAD_MAX_ROWS=5000
PREVIEW_TTL_MINUTES=30
MEDIA_STORAGE_DIR=./data/media
MEDIA_PUBLIC_URL=http://localhost:8000/media
MESSAGING_PROVIDER=simulator
DISPATCHER_INTERVAL_SECONDS=5
DISPATCHER_BATCH_SIZE=100
SIM_DELIVERY_DELAY_SECONDS=2
SIM_AUTO_READ_RATE=0.6
SIM_AUTO_READ_DELAY_SECONDS=10
SIM_TYPING_SECONDS=1.5

LLM_ENABLED=false
LLM_PROVIDER_ORDER=groq,cerebras,gemini,mistral,together,openrouter
LLM_TIMEOUT_SECONDS=4
LLM_MAX_RETRIES_PER_PROVIDER=0
LLM_TOTAL_BUDGET_SECONDS=12
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN_SECONDS=120

GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tihbc-donor-recall-demo
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

AGENT_CONFIDENCE_THRESHOLD=0.7

SEED_ADMIN_EMAIL=admin@tihbc.demo
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_COORDINATOR_EMAIL=coordinator@tihbc.demo
SEED_COORDINATOR_PASSWORD=ChangeMe123!
