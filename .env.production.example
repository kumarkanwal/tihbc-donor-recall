# Copy to .env.production on the VPS and set mode 600.
# Every CHANGE_ME value must be replaced before deployment.

# PostgreSQL container settings. Keep these credentials synchronized with DATABASE_URL.
POSTGRES_DB=tihbc
POSTGRES_USER=tihbc
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Backend application settings.
APP_ENV=production
DEMO_MODE=true
API_BASE_PATH=/api/v1
CORS_ORIGINS=CHANGE_ME_CORS_ORIGINS
DATABASE_URL=postgresql+asyncpg://tihbc:CHANGE_ME_POSTGRES_PASSWORD@tihbc-db:5432/tihbc
TEST_DATABASE_URL=
REDIS_URL=redis://tihbc-redis:6379/0
TEST_REDIS_URL=redis://tihbc-redis:6379/15
RUN_MIGRATIONS=false
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_MINUTES=720
LOG_LEVEL=INFO
TIMEZONE_DISPLAY=Asia/Karachi
UPLOAD_MAX_MB=10
UPLOAD_MAX_ROWS=5000
PREVIEW_TTL_MINUTES=30
MEDIA_STORAGE_DIR=/data/media
MEDIA_PUBLIC_URL=https://tihbc.kanwalkumar.com/media
MESSAGING_PROVIDER=simulator
DISPATCHER_INTERVAL_SECONDS=5
DISPATCHER_BATCH_SIZE=100
SIM_DELIVERY_DELAY_SECONDS=2
SIM_AUTO_READ_RATE=0.6
SIM_AUTO_READ_DELAY_SECONDS=10
SIM_TYPING_SECONDS=1.5

# Optional reply-agent providers. Blank keys disable that provider.
LLM_ENABLED=false
LLM_PROVIDER_ORDER=groq,cerebras,gemini,mistral,together,openrouter
LLM_TIMEOUT_SECONDS=4
LLM_MAX_RETRIES_PER_PROVIDER=0
LLM_TOTAL_BUDGET_SECONDS=12
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN_SECONDS=120
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AGENT_CONFIDENCE_THRESHOLD=0.7

# Optional LangSmith tracing. Provide a key before setting tracing to true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tihbc-donor-recall-demo
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Demo users. Both passwords must be changed before the first seed.
SEED_ADMIN_EMAIL=admin@tihbc.demo
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_COORDINATOR_EMAIL=coordinator@tihbc.demo
SEED_COORDINATOR_PASSWORD=CHANGE_ME_COORDINATOR_PASSWORD

# Public frontend values. These are also baked into the production web image.
NEXT_PUBLIC_API_URL=https://tihbc.kanwalkumar.com/api/v1
NEXT_PUBLIC_WS_URL=wss://tihbc.kanwalkumar.com/ws
NEXT_PUBLIC_APP_NAME=TIHBC Donor Recall
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SIMULATOR_SOURCE=api
NEXT_PUBLIC_REALTIME=on
